#!/bin/bash
# Lazily acquire and run the latest stable yt-dlp without a global install.
set -euo pipefail

usage() {
  cat <<'HELP'
Usage: scripts/run [YT-DLP_ARGS...]

On invocation, npx acquires or updates a cache-local official yt-dlp stable
binary, then every argument is passed through unchanged.
HELP
}

if [[ "${1:-}" == "--help-runner" ]]; then
  usage
  exit 0
fi

if ! command -v npx >/dev/null 2>&1; then
  echo "yt-dlp runner: npx is required (install Node.js 18 or newer)" >&2
  exit 127
fi

cache_root="${YTDLP_RUNNER_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/skillmonger/yt-dlp}"
binary="$cache_root/yt-dlp"
npm_cache="$cache_root/npm"

mkdir -p "$cache_root" "$npm_cache"

python_runtime=""
for candidate in python3 python3.14 python3.13 python3.12 python3.11 python3.10 /opt/homebrew/bin/python3; do
  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys; raise SystemExit(sys.version_info < (3, 10))' 2>/dev/null; then
    python_runtime="$(command -v "$candidate")"
    break
  fi
done

if [[ -z "$python_runtime" ]]; then
  echo "yt-dlp runner: Python 3.10 or newer is required by yt-dlp" >&2
  exit 127
fi

echo "yt-dlp runner: lazily acquiring or updating the official stable binary via npx" >&2
npm_config_cache="$npm_cache" npx --yes yt-dlp-dl@1.0.1 "$cache_root" >&2

exec "$python_runtime" "$binary" "$@"
